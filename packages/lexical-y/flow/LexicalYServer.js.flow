import type {Doc} from '@y/y';

/**
 * @lexical/y/server: EXPERIMENTAL helpers for servers relaying @lexical/y
 * documents.
 */

declare export var DEFAULT_ROOT_NAME: string;
declare export var LAYOUT_VERSION: number;

export type UpdateRoots = {roots: Set<string>, unresolved: number};

declare export function inspectUpdateRoots(
  update: Uint8Array,
  doc?: Doc,
): UpdateRoots;

declare export function isUpdateForLayout(
  update: Uint8Array,
  options?: {root?: string, doc?: Doc},
): boolean;

declare export function writeUpgradeNotice(
  doc: Doc,
  message?: string,
  oldRoot?: 'root-v2' | 'root',
  options?: {root?: string},
): void;
